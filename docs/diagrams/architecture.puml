@startuml
title StudySpots - Arhitectura generala
left to right direction
skinparam componentStyle rectangle

actor "Student" as S
actor "Administrator" as A

package "Browser" {
  component "Frontend web" as UI
  component "Harta\n(ArcGIS Maps SDK for JS)" as MAP
  component "Dashboard\n(grafice)" as DASH
  component "Geolocation API" as GEO
}

package "Convex (cloud)" {
  component "Functii server\n(query / mutation)" as FN
  component "Autentificare\n(Convex Auth, roluri)" as AUTH
  database "Convex DB\nusers, places,\nreviews, favorites" as DB
}

cloud "ArcGIS\n(basemap)" as ARC

S --> UI
A --> UI
UI --> MAP
UI --> DASH
UI --> GEO : pozitie utilizator
MAP --> ARC : harta de baza
UI --> FN : WebSocket (reactiv)
FN --> AUTH
FN --> DB : citire / scriere
@enduml
